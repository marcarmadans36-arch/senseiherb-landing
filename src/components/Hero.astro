---
const APP_URL = "https://app.senseiherb.com";
---

<section
  class="relative min-h-dvh flex flex-col items-center justify-center overflow-hidden px-5 pt-20 pb-16 text-center"
  style="background: radial-gradient(ellipse 100% 70% at 50% 0%, #142018 0%, #080e0b 65%);"
  aria-label="Presentación de SenseiHerb"
>
  <!-- Fondo estático -->
  <img
    src="/assets/hero-bg.png"
    alt=""
    role="presentation"
    class="absolute inset-0 w-full h-full object-cover opacity-20 select-none pointer-events-none"
    width="1440" height="960"
    fetchpriority="high"
  />

  <!-- Vídeo solo desktop -->
  <video
    class="absolute inset-0 w-full h-full object-cover opacity-15 hidden md:block select-none pointer-events-none"
    autoplay muted loop playsinline
    poster="/assets/hero-bg.png"
    aria-hidden="true"
  >
    <source src="/assets/hero-loop.mp4" type="video/mp4" />
  </video>

  <!-- Fade al fondo de la sección siguiente -->
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#080e0b] pointer-events-none" aria-hidden="true" />

  <!-- Contenido -->
  <div class="relative z-10 flex flex-col items-center gap-7 max-w-2xl mx-auto animate-fade-up">

    <!-- Logo Sensei -->
    <div class="relative flex items-center justify-center">
      <!-- Glow ambiental -->
      <div class="absolute w-48 h-48 rounded-full bg-dojo-green/10 blur-3xl" aria-hidden="true" />
      <img
        src="/assets/sensei-logo.png"
        alt="Logo SenseiHerb — El Sensei"
        class="relative w-36 h-auto md:w-48 drop-shadow-[0_8px_32px_rgba(52,211,153,0.3)]"
        width="192" height="354"
        fetchpriority="high"
      />
    </div>

    <!-- Nombre y badge -->
    <div class="flex flex-col items-center gap-3">
      <h1 class="font-display font-black text-4xl md:text-6xl leading-tight tracking-tight text-white">
        <span class="text-dojo-green">Sensei</span>Herb
      </h1>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-dojo-gold/30 bg-dojo-gold/10 text-dojo-gold text-xs font-semibold tracking-widest uppercase">
        +18 · Solo uso informativo
      </span>
    </div>

    <!-- Subtítulo -->
    <p class="text-dojo-muted text-lg md:text-xl leading-relaxed max-w-lg">
      La guía de cannabis y CBD para España. Descubre variedades, cultiva con IA y encuentra clubs cerca de ti.
    </p>

    <!-- CTA -->
    <a
      href="#registro"
      class="inline-flex items-center gap-2 h-14 px-8 rounded-2xl font-semibold text-base text-white shadow-green transition-all hover:scale-105 active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-dojo-green focus-visible:outline-offset-2"
      style="background: linear-gradient(135deg, #34d399, #059669);"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Avisarme del lanzamiento
    </a>

    <p class="text-xs text-dojo-muted/50">Contenido informativo y educativo · No fomenta el consumo</p>
  </div>

  <!-- Flecha scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="2" stroke-linecap="round">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </div>
</section>
