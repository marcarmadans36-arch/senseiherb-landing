</style>

<script>
(function() {
  const steps   = Array.from(document.querySelectorAll('.sht-step'));
  const screens = Array.from(document.querySelectorAll('.sht-scr'));
  const glow    = document.getElementById('sht-glow');
  let current   = -1;
  let mapInited = false;

  const GLOWS = [
    'radial-gradient(circle,rgba(52,211,153,.65),transparent 65%)',
    'radial-gradient(circle,rgba(251,191,36,.6),transparent 65%)',
    'radial-gradient(circle,rgba(52,211,153,.55),transparent 65%)',
    'radial-gradient(circle,rgba(21,101,192,.5),transparent 65%)',
    'radial-gradient(circle,rgba(251,191,36,.6),transparent 65%)',
  ];

  function setScreen(i) {
    if (i === current) return;
    current = i;
    screens.forEach(s => s.classList.toggle('sht-on', +s.dataset.scr === i));
    steps.forEach(s   => s.classList.toggle('sht-on', +s.dataset.step === i));
    if (glow) glow.style.background = GLOWS[i] || GLOWS[0];
    if (i === 3 && !mapInited) initMap();
  }

  function initMap() {
    mapInited = true;
    const scr = document.createElement('script');
    scr.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    scr.onload = buildMap;
    document.head.appendChild(scr);
  }

  function buildMap() {
    const el = document.getElementById('sht-map');
    if (!el || !window.L) return;
    const map = window.L.map(el, {
      center: [41.389, 2.158], zoom: 14,
      zoomControl: false, attributionControl: false,
      dragging: false, scrollWheelZoom: false,
      doubleClickZoom: false, touchZoom: false,
    });
    window.L.tileLayer(
      'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
      { maxZoom: 19 }
    ).addTo(map);
    const clubs = [
      { ll:[41.3892,2.1643], hi:true },
      { ll:[41.4028,2.1558] },
      { ll:[41.3762,2.1498] },
      { ll:[41.4060,2.1402] },
      { ll:[41.4002,2.1980] },
      { ll:[41.3824,2.1760] },
    ];
    clubs.forEach(c => {
      const size = c.hi ? 14 : 10;
      const color = c.hi ? '#34d399' : 'rgba(52,211,153,.5)';
      const shadow = c.hi ? 'box-shadow:0 0 0 6px rgba(52,211,153,.2);' : '';
      const icon = window.L.divIcon({
        className: '',
        html: `<div style="width:${size}px;height:${size}px;border-radius:50%;background:${color};border:2px solid #fff;${shadow}"></div>`,
        iconSize: [size, size], iconAnchor: [size/2, size/2],
      });
      window.L.marker(c.ll, { icon }).addTo(map);
    });
    setTimeout(() => map.invalidateSize(), 120);
  }

  const io = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) setScreen(+e.target.dataset.step); }),
    { threshold: 0.4 }
  );
  steps.forEach(s => io.observe(s));
  setScreen(0);
})();
</script>
