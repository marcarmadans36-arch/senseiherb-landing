    align-items:flex-start;
    padding-top:10px;
  }
  .sht-phone{transform:scale(0.6);transform-origin:top center}
  .sht-glow{filter:blur(36px);opacity:.15}

  /* Steps: debajo del iPhone, solo tag + bullets */
  .sht-steps{grid-column:1;grid-row:2;display:flex;flex-direction:column}
