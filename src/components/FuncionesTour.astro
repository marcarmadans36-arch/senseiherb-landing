/* ─── Tour ───────────────────────────────────── */
.sht-tour{position:relative;z-index:2;max-width:1100px;margin:0 auto;padding:0 20px}

/* ─── Grid ───────────────────────────────────── */
.sht-grid{display:grid;grid-template-columns:1fr 286px 1fr}

/* ─── Phone column (sticky) ─────────────────── */
.sht-pcol{
  grid-column:2;grid-row:1;
