  display:flex;align-items:center;justify-content:center;
  z-index:10;pointer-events:none;
}

/* ─── Steps overlay ──────────────────────────── */
.sht-steps{
  grid-column:1/-1;grid-row:1;           /* ocupa todo el grid, misma fila que phone */
  display:grid;
  grid-template-columns:1fr 286px 1fr;   /* igual que sht-grid */
  position:relative;z-index:5;pointer-events:none;
}

/* ─── Cada step ──────────────────────────────── */
.sht-step{min-height:100vh;display:flex;align-items:center;padding:40px 0}

/* Fila explícita para que cada step ocupe su propia fila */
.sht-step:nth-child(1){grid-row:1}
.sht-step:nth-child(2){grid-row:2}
.sht-step:nth-child(3){grid-row:3}
.sht-step:nth-child(4){grid-row:4}
.sht-step:nth-child(5){grid-row:5}

/* sr = RIGHT of phone → column 3, text left-aligned */
.sht-sr{grid-column:3;justify-content:flex-start;padding-left:32px}
/* sl = LEFT of phone  → column 1, text right-aligned */
.sht-sl{grid-column:1;justify-content:flex-end;padding-right:32px}

.sht-inner{
  max-width:290px;pointer-events:auto;
  opacity:.15;transform:translateY(16px);
  transition:opacity .5s,transform .5s;
}
.sht-step.sht-on .sht-inner{opacity:1;transform:none}

.sht-sr .sht-inner{text-align:left}
.sht-sl .sht-inner{text-align:right}

.sht-stag{font-size:11px;letter-spacing:.26em;text-transform:uppercase;font-weight:700;margin-bottom:12px;display:block}
.sht-sh3{font-family:'Zen Kaku Gothic New',system-ui;font-weight:700;font-size:clamp(19px,2.2vw,26px);color:#fff;line-height:1.25;margin-bottom:11px}
