---
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<section id="funciones" aria-labelledby="funciones-title" class="sht-sec">

  <!-- Fondo difuminado -->
  <div class="sht-bg" aria-hidden="true">
    <img src="/assets/hero-bg.png" alt="" width="1440" height="960" />
  </div>

  <!-- Encabezado -->
  <div class="sht-hdr">
    <p class="sht-eye">La app por dentro</p>
    <h2 id="funciones-title" class="sht-h2">Haz scroll y deja<br>que el <em>Sensei</em> te enseñe</h2>
    <p class="sht-hsub">Un recorrido por las cuatro funciones como si estuvieras usando la app.</p>
  </div>

  <!-- Tour -->
  <div class="sht-tour">
    <div class="sht-grid">

      <!-- ── iPhone central (sticky) ── -->
      <div class="sht-pcol">
        <div class="sht-phone">
          <div class="sht-glow" id="sht-glow"></div>
          <div class="sht-shell">
            <div class="sht-btn sht-v1"></div>
            <div class="sht-btn sht-v2"></div>
            <div class="sht-btn sht-pw"></div>
            <div class="sht-display">
              <div class="sht-di"></div><!-- Dynamic Island -->

              <!-- ─ Pantalla 0 · Descubrir ─ -->
              <div class="sht-scr sht-on" data-scr="0">
                <div class="sht-sb">
                  <span>09:41</span>
                  <div class="sht-icons">
                    <svg width="13" height="9" viewBox="0 0 14 10"><rect x="0" y="3" width="3" height="7" rx=".7" fill="currentColor" opacity=".35"/><rect x="4" y="2" width="3" height="8" rx=".7" fill="currentColor" opacity=".6"/><rect x="8" y="0" width="3" height="10" rx=".7" fill="currentColor"/><rect x="12.5" y="4" width="1.5" height="6" rx=".5" fill="currentColor" opacity=".25"/></svg>
                    <svg width="15" height="8" viewBox="0 0 25 12"><rect x="0" y="1" width="21" height="10" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="2" y="3" width="13" height="6" rx="1.5" fill="#34d399"/><rect x="22" y="3.5" width="3" height="5" rx="1.5" fill="currentColor" opacity=".4"/></svg>
                  </div>
                </div>
                <div class="sht-pv">
                  <!-- Header -->
                  <div class="sht-app-hdr">
                    <div>
                      <p class="sht-eyebrow-app">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="#34d399"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2Z"/></svg>
                        SenseiHerb
                      </p>
                      <h1 class="sht-screen-h1">Descubrir</h1>
                    </div>
                    <div class="sht-icon-btn" style="background:linear-gradient(135deg,#34d399,#059669)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z"/></svg>
                    </div>
                  </div>
                  <p class="sht-screen-sub">¿Cómo quieres sentirte hoy? Te orientamos sobre variedades que suelen asociarse a ese estado.</p>

                  <p class="sht-section-label">Elige un mood</p>
                  <div class="sht-mood-grid">
                    <!-- Relajación — ocean -->
                    <div class="sht-mc" style="background:linear-gradient(180deg,#041820 0%,#073b4c 45%,#0c6073 100%)">
                      <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 72% 18%,rgba(186,230,253,.32) 0%,transparent 55%)"></div>
                      <div style="position:absolute;bottom:0;left:0;right:0;height:55%;background:linear-gradient(180deg,rgba(14,165,233,.15) 0%,rgba(7,89,133,.38) 100%)"></div>
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.68) 0%,rgba(0,0,0,.08) 55%,transparent 100%)"></div>
                      <span class="sht-mc-label">Relajación</span>
                    </div>
                    <!-- Dormir — noche -->
                    <div class="sht-mc" style="background:linear-gradient(160deg,#010108 0%,#0c0a2e 55%,#160c38 100%)">
                      <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 80% 18%,rgba(220,220,255,.22) 0%,transparent 45%)"></div>
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.68) 0%,transparent 60%)"></div>
                      <span class="sht-mc-label">Dormir</span>
                    </div>
                    <!-- Creatividad — purple -->
                    <div class="sht-mc" style="background:linear-gradient(145deg,#1a0533 0%,#3d0d6b 50%,#620f94 100%)">
                      <div style="position:absolute;top:-12%;left:3%;width:62%;height:82%;background:radial-gradient(ellipse,rgba(236,72,153,.5) 0%,transparent 65%)"></div>
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.68) 0%,transparent 60%)"></div>
                      <span class="sht-mc-label">Creatividad</span>
                    </div>
                    <!-- Concentración — green -->
                    <div class="sht-mc" style="background:#040806">
                      <div style="position:absolute;inset:0;background:radial-gradient(ellipse 52% 82% at 50% -8%,rgba(52,211,153,.62) 0%,rgba(16,185,129,.2) 42%,transparent 68%)"></div>
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(4,8,6,.88) 0%,transparent 55%)"></div>
                      <span class="sht-mc-label">Concentración</span>
                    </div>
                    <!-- Social — ciudad -->
                    <div class="sht-mc" style="background:linear-gradient(180deg,#080402 0%,#1c0e02 48%,#2f1b04 100%)">
                      <div style="position:absolute;top:12%;left:18%;width:42%;height:62%;background:radial-gradient(ellipse,rgba(251,146,60,.38) 0%,transparent 70%)"></div>
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.68) 0%,transparent 55%)"></div>
                      <span class="sht-mc-label">Social</span>
                    </div>
                    <!-- Anti-ansiedad — forest -->
                    <div class="sht-mc" style="background:linear-gradient(180deg,#010d09 0%,#032a1e 40%,#054f38 75%,#0a7c58 100%)">
                      <div style="position:absolute;bottom:28%;left:0;right:0;height:42%;background:radial-gradient(ellipse 100% 60% at 50% 100%,rgba(167,243,208,.32) 0%,transparent 74%)"></div>
                      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.68) 0%,transparent 55%)"></div>
                      <span class="sht-mc-label">Anti-ansiedad</span>
                    </div>
                  </div>

                  <button class="sht-cta-btn">Ver recomendaciones <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
                </div>
                <!-- Nav -->
                <div class="sht-nav">
                  <a class="sht-ni sht-nact"><div class="sht-ni-ic" style="background:linear-gradient(135deg,#34d399,#059669)"><svg viewBox="0 0 24 24" fill="white"><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="white" stroke-width="2" fill="none"/></svg></div><span>Descubrir</span></a>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3"/></svg></div><span>Cámara</span></a>
                  <div class="sht-nc"><div class="sht-nc-btn"><img src="/assets/sensei-logo.png" alt="" width="32" height="59" /></div><span>Sensei</span></div>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><path d="M12 21s7-6.5 7-12A7 7 0 0 0 5 9c0 5.5 7 12 7 12Z"/></svg></div><span>Clubs</span></a>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M5 20c.7-3.8 3.6-6 7-6s6.3 2.2 7 6"/></svg></div><span>Perfil</span></a>
                </div>
              </div>

              <!-- ─ Pantalla 1 · Sensei / Dojo ─ -->
              <div class="sht-scr" data-scr="1">
                <div class="sht-sb sht-sb-gold"><span>09:41</span><div class="sht-icons"><svg width="13" height="9" viewBox="0 0 14 10"><rect x="0" y="3" width="3" height="7" rx=".7" fill="currentColor" opacity=".35"/><rect x="4" y="2" width="3" height="8" rx=".7" fill="currentColor" opacity=".6"/><rect x="8" y="0" width="3" height="10" rx=".7" fill="currentColor"/></svg><svg width="15" height="8" viewBox="0 0 25 12"><rect x="0" y="1" width="21" height="10" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="2" y="3" width="13" height="6" rx="1.5" fill="#34d399"/><rect x="22" y="3.5" width="3" height="5" rx="1.5" fill="currentColor" opacity=".4"/></svg></div></div>
                <div class="sht-pv">
                  <div class="sht-dojo-hdr">
                    <div>
                      <h1 class="sht-screen-h1">Dojo</h1>
                      <p class="sht-screen-sub" style="margin-top:1px">Tu maestro del autocultivo</p>
                    </div>
                  </div>

                  <!-- RankCard -->
                  <div class="sht-rank-card">
                    <div class="sht-rank-left">
                      <div class="sht-rank-ring">
                        <svg width="44" height="44" viewBox="0 0 50 50">
                          <circle cx="25" cy="25" r="20" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="5"/>
                          <circle cx="25" cy="25" r="20" fill="none" stroke="#fbbf24" stroke-width="5" stroke-linecap="round"
                            stroke-dasharray="125.6" stroke-dashoffset="46" transform="rotate(-90 25 25)"/>
                        </svg>
                      </div>
                    </div>
                    <div class="sht-rank-right">
                      <div class="sht-rank-title">Cinturón Verde · Nivel 4</div>
                      <div class="sht-rank-sub">620 / 1000 XP · 🔥 5 días</div>
                      <div class="sht-xpbar"><div class="sht-xpfill" style="width:62%"></div></div>
                    </div>
                  </div>

                  <!-- Tab bar -->
                  <div class="sht-tabs">
                    <button class="sht-tab sht-tab-act">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="white"><path d="M21 12a8 8 0 0 1-8 8H4l2-2a8 8 0 1 1 15-6Z"/></svg>
                      Chat
                    </button>
                    <button class="sht-tab">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="2"><circle cx="12" cy="12" r="9"/></svg>
                      Cultivo
                    </button>
                    <button class="sht-tab">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                      Tareas
                    </button>
                  </div>

                  <!-- Mensajes de chat -->
                  <div class="sht-chat">
                    <div class="sht-msg-row sht-msg-sensei">
                      <div class="sht-ava"><span>🌿</span></div>
                      <div class="sht-bubble sht-bubble-sensei">
                        <strong style="color:#fbbf24">¡Saludos, aprendiz!</strong> Tus Critical van por el día 24 de floración. El tricoma está madurando — pronto es el momento de cosechar.
                      </div>
                    </div>
                    <div class="sht-msg-row sht-msg-user">
                      <div class="sht-bubble sht-bubble-user">¿Cuánto más le dejo?</div>
                    </div>
                    <div class="sht-msg-row sht-msg-sensei">
                      <div class="sht-ava"><span>🌿</span></div>
                      <div class="sht-bubble sht-bubble-sensei">
                        Con la humedad que tienes, te recomiendo <strong style="color:#fbbf24">4-6 días más</strong>. Fíjate en que el 80% de tricomas estén lechosos.
                      </div>
                    </div>
                  </div>
                  <!-- Input -->
                  <div class="sht-input-row">
                    <div class="sht-cam-btn"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="2"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3"/></svg></div>
                    <div class="sht-input-fake">Pregunta al Sensei…</div>
                    <div class="sht-send-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></div>
                  </div>
                </div>
                <!-- Nav -->
                <div class="sht-nav">
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3" stroke="rgba(255,255,255,.45)" stroke-width="1.8"/></svg></div><span>Descubrir</span></a>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3"/></svg></div><span>Cámara</span></a>
                  <div class="sht-nc"><div class="sht-nc-btn sht-nc-act"><img src="/assets/sensei-logo.png" alt="" width="32" height="59" /></div><span style="color:#fbbf24">Sensei</span></div>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><path d="M12 21s7-6.5 7-12A7 7 0 0 0 5 9c0 5.5 7 12 7 12Z"/></svg></div><span>Clubs</span></a>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M5 20c.7-3.8 3.6-6 7-6s6.3 2.2 7 6"/></svg></div><span>Perfil</span></a>
                </div>
              </div>

              <!-- ─ Pantalla 2 · Cámara ─ -->
              <div class="sht-scr" data-scr="2">
                <div class="sht-sb"><span>09:41</span><div class="sht-icons"><svg width="13" height="9" viewBox="0 0 14 10"><rect x="0" y="3" width="3" height="7" rx=".7" fill="currentColor" opacity=".35"/><rect x="4" y="2" width="3" height="8" rx=".7" fill="currentColor" opacity=".6"/><rect x="8" y="0" width="3" height="10" rx=".7" fill="currentColor"/></svg><svg width="15" height="8" viewBox="0 0 25 12"><rect x="0" y="1" width="21" height="10" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="2" y="3" width="13" height="6" rx="1.5" fill="#34d399"/><rect x="22" y="3.5" width="3" height="5" rx="1.5" fill="currentColor" opacity=".4"/></svg></div></div>
                <div class="sht-pv">
                  <div class="sht-app-hdr">
                    <div>
                      <p class="sht-eyebrow-app" style="color:#34d399">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3"/></svg>
                        Escáner IA
                      </p>
                      <h1 class="sht-screen-h1">Informe</h1>
                    </div>
                  </div>
                  <!-- Visor -->
                  <div class="sht-viewfinder">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="rgba(165,243,207,.65)" stroke-width="1.1">
                      <path d="M12 21V8M12 8c-2-1.4-5-1.2-7.5.8 1.8 2.6 4.8 3.2 7.5 1.8ZM12 8c2-1.4 5-1.2 7.5.8-1.8 2.6-4.8 3.2-7.5 1.8ZM12 12c-1.8-1.2-4.3-.9-6.4 1M12 12c1.8-1.2 4.3-.9 6.4 1"/>
                    </svg>
                    <div class="sht-sc sht-sc-tl"></div><div class="sht-sc sht-sc-tr"></div>
                    <div class="sht-sc sht-sc-bl"></div><div class="sht-sc sht-sc-br"></div>
                    <div class="sht-photo-tag">📷 Analizado · luz buena</div>
                  </div>
                  <!-- Resultado -->
                  <div class="sht-result-hdr">
                    <span>Informe de estado</span>
                    <span class="sht-grade">Buen estado</span>
                  </div>
                  <div class="sht-result-ok">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                    Tricomas lechosos: punto óptimo para cosechar.
                  </div>
                  <div class="sht-result-ok">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
                    Sin signos visibles de plagas o enfermedades.
                  </div>
                  <div class="sht-alert">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2"><path d="M12 9v4M12 17h.01M10.3 4 3 17a2 2 0 0 0 1.7 3h14.6a2 2 0 0 0 1.7-3L13.7 4a2 2 0 0 0-3.4 0Z"/></svg>
                    Posible humedad en la base — vigila el moho.
                  </div>
                </div>
                <!-- Nav -->
                <div class="sht-nav">
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12" stroke="rgba(255,255,255,.45)" stroke-width="1.8"/></svg></div><span>Descubrir</span></a>
                  <a class="sht-ni sht-nact"><div class="sht-ni-ic" style="background:linear-gradient(135deg,#34d399,#059669)"><svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3"/></svg></div><span>Cámara</span></a>
                  <div class="sht-nc"><div class="sht-nc-btn"><img src="/assets/sensei-logo.png" alt="" width="32" height="59" /></div><span>Sensei</span></div>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><path d="M12 21s7-6.5 7-12A7 7 0 0 0 5 9c0 5.5 7 12 7 12Z"/></svg></div><span>Clubs</span></a>
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M5 20c.7-3.8 3.6-6 7-6s6.3 2.2 7 6"/></svg></div><span>Perfil</span></a>
                </div>
              </div>

              <!-- ─ Pantalla 3 · Clubs ─ -->
              <div class="sht-scr sht-map-scr" data-scr="3">
                <div class="sht-sb sht-sb-over"><span>09:41</span><div class="sht-icons"><svg width="13" height="9" viewBox="0 0 14 10"><rect x="0" y="3" width="3" height="7" rx=".7" fill="currentColor" opacity=".35"/><rect x="4" y="2" width="3" height="8" rx=".7" fill="currentColor" opacity=".6"/><rect x="8" y="0" width="3" height="10" rx=".7" fill="currentColor"/></svg><svg width="15" height="8" viewBox="0 0 25 12"><rect x="0" y="1" width="21" height="10" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="2" y="3" width="13" height="6" rx="1.5" fill="#34d399"/><rect x="22" y="3.5" width="3" height="5" rx="1.5" fill="currentColor" opacity=".4"/></svg></div></div>
                <div id="sht-map"></div>
                <!-- Overlay inferior -->
                <div class="sht-map-ov">
                  <p class="sht-map-title">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><path d="M12 21s7-6.5 7-12A7 7 0 0 0 5 9c0 5.5 7 12 7 12Z"/></svg>
                    Clubs cerca de ti · Barcelona
                  </p>
                  <div class="sht-club">
                    <div class="sht-club-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M12 21s7-6.5 7-12A7 7 0 0 0 5 9c0 5.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></div>
                    <div><b>Barcelona Cannabis Club</b><small>Eixample · 620 m</small></div>
                    <span class="sht-star">★ 4.9</span>
                  </div>
                  <div class="sht-club" style="opacity:.6">
                    <div class="sht-club-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M12 21s7-6.5 7-12A7 7 0 0 0 5 9c0 5.5 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></div>
                    <div><b>Gràcia Canna Society</b><small>Gràcia · 1.2 km</small></div>
                    <span class="sht-star">★ 4.7</span>
                  </div>
                </div>
                <!-- Nav -->
                <div class="sht-nav sht-nav-over">
                  <a class="sht-ni"><div class="sht-ni-ic"><svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="1.8"><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3" stroke="rgba(255,255,255,.45)" stroke-width="1.8"/></svg></div><span>Descubrir</span></a>
